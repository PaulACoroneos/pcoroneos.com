{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    "node_modules/**",
    "test-results/**"
  ]
}
