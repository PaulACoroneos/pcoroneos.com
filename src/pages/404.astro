---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/with-base";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found - Paul Coroneos" description="The page you were looking for doesn't exist.">
  <div class="space-y-6 py-16 text-center md:py-24" data-testid="not-found">
    <p class="font-display text-6xl font-extrabold text-primary">404</p>
    <h1 class="font-display text-3xl font-extrabold tracking-tight text-text sm:text-4xl">
      Page not found
    </h1>
    <p class="text-lg text-text-muted">
      The page you were looking for doesn't exist or has moved.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href={withBase(base, "/")}
        class="inline-flex min-h-[44px] items-center rounded-lg bg-primary px-5 py-2 font-medium text-on-primary transition-colors hover:bg-primary-hover"
      >
        Go home
      </a>
      <a
        href={withBase(base, "/blog")}
        class="inline-flex min-h-[44px] items-center rounded-lg border border-border bg-surface px-5 py-2 font-medium text-text transition-colors hover:text-primary"
      >
        Browse the blog
      </a>
    </div>
  </div>
</BaseLayout>
